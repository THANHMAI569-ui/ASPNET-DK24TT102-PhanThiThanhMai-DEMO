@model CategoryListItemViewModel
@{
    ViewData["Title"] = "Xóa danh mục";
}

<div class="surface stack">
    <h1>Xóa danh mục</h1>
    <p>Bạn sắp xóa danh mục <strong>@Model.Name</strong>.</p>

    <div class="spec-grid">
        <div class="spec">
            <span class="spec__label">Số món trong danh mục</span>
            <span class="spec__value tnum">@Model.RecipeCount</span>
        </div>
    </div>

    @if (Model.RecipeCount > 0)
    {
        <div class="notice">
            Danh mục đang có <strong>@Model.RecipeCount</strong> món ăn nên chưa thể xóa. Hãy chuyển hoặc xóa các món trước.
        </div>
    }
    else
    {
        <div class="notice">Thao tác này không thể hoàn tác.</div>
    }

    <form asp-action="Delete" method="post" class="row-inline">
        <input type="hidden" name="id" value="@Model.Id"/>
        <button type="submit" class="btn btn--solid-danger" disabled="@(Model.RecipeCount > 0)">Xóa</button>
        <a class="btn btn--quiet" asp-action="Index">Hủy</a>
    </form>
</div>
