@model IReadOnlyList<IngredientListItemViewModel>
@{
    ViewData["Title"] = "Quản lý nguyên liệu";
}

<div class="page-head">
    <div class="page-head__text">
        <h1>Nguyên liệu</h1>
        <p class="page-head__lede">Quản lý danh sách nguyên liệu dùng trong các món ăn.</p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn--accent" asp-action="Create"><icon name="plus"/> Thêm nguyên liệu</a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="empty">
        <span class="empty__icon"><icon name="carrot" class="ico--lg"/></span>
        <p class="empty__title">Chưa có nguyên liệu nào</p>
        <p class="empty__text">Thêm nguyên liệu đầu tiên để dùng trong công thức món ăn.</p>
        <a class="btn btn--outline" asp-action="Create">Thêm nguyên liệu</a>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">Tên</th>
                    <th scope="col">Đơn vị</th>
                    <th scope="col">Nhóm</th>
                    <th scope="col" class="data-table__num">Dùng trong</th>
                    <th scope="col">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ingredient in Model)
                {
                    <tr>
                        <td class="fw-600">@ingredient.Name</td>
                        <td>@ingredient.Unit</td>
                        <td>@ingredient.Group</td>
                        <td class="data-table__num tnum">@ingredient.UsageCount món</td>
                        <td>
                            <div class="data-table__actions">
                                <a class="icon-btn" asp-action="Edit" asp-route-id="@ingredient.Id" aria-label="Sửa @ingredient.Name">
                                    <icon name="pencil"/>
                                </a>
                                <a class="icon-btn" asp-action="Delete" asp-route-id="@ingredient.Id" aria-label="Xóa @ingredient.Name">
                                    <icon name="trash"/>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
