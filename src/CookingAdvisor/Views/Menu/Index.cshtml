@model MenuIndexViewModel
@{
    ViewData["Title"] = "Thực đơn tuần";
}

<div class="page-head">
    <div class="page-head__text">
        <h1>Thực đơn tuần</h1>
        <p class="page-head__lede">Tạo thực đơn mới hoặc mở lại một thực đơn đã lưu.</p>
    </div>
</div>

<div class="stack">
    <div class="surface">
        <form asp-action="Generate" method="post" class="stack">
            <div asp-validation-summary="ModelOnly"></div>
            <div class="form-grid">
                <div class="field">
                    <label class="field__label" asp-for="Form.Name">Tên thực đơn</label>
                    <input class="input" asp-for="Form.Name"/>
                    <span class="field__error" asp-validation-for="Form.Name"></span>
                </div>
                <div class="field">
                    <label class="field__label" asp-for="Form.WeekStartDate">Tuần bắt đầu</label>
                    <input class="input" asp-for="Form.WeekStartDate" type="date"/>
                    <span class="field__error" asp-validation-for="Form.WeekStartDate"></span>
                </div>
                <div class="field">
                    <label class="field__label" asp-for="Form.Region">Vùng miền</label>
                    <select class="select" asp-for="Form.Region" asp-items="Html.GetEnumSelectList<Region>()">
                        <option value="">Tất cả</option>
                    </select>
                    <span class="field__error" asp-validation-for="Form.Region"></span>
                </div>
            </div>
            <button type="submit" class="btn btn--accent">Tạo thực đơn</button>
        </form>
    </div>

    <div class="section-head">
        <h2>Thực đơn đã tạo</h2>
    </div>

    @if (Model.Plans.Count == 0)
    {
        <div class="empty">
            <span class="empty__icon"><icon name="calendar-month" class="ico--lg"/></span>
            <p class="empty__title">Chưa có thực đơn nào</p>
            <p class="empty__text">Tạo thực đơn đầu tiên bằng biểu mẫu ở trên.</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">Tên thực đơn</th>
                        <th scope="col" class="data-table__num">Tuần bắt đầu</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var plan in Model.Plans)
                    {
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@plan.Id">@plan.Name</a></td>
                            <td class="data-table__num">@plan.WeekStartDate.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
