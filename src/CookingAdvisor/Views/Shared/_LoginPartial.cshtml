@using Microsoft.AspNetCore.Identity
@using CookingAdvisor.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var displayName = (await UserManager.GetUserAsync(User))?.FullName ?? User.Identity?.Name;

    <span class="user-chip">
        <icon name="user-circle"/>
        <span class="user-chip__name">@displayName</span>
    </span>
    <form asp-controller="Account" asp-action="Logout" method="post">
        <button class="icon-btn" type="submit" aria-label="Đăng xuất">
            <icon name="logout"/>
        </button>
    </form>
}
else
{
    <a class="btn btn--quiet btn--sm" asp-controller="Account" asp-action="Login">Đăng nhập</a>
    <a class="btn btn--accent btn--sm" asp-controller="Account" asp-action="Register">Đăng ký</a>
}
