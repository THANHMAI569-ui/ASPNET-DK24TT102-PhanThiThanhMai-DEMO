@model RecipeAdminListItemViewModel
@{
    ViewData["Title"] = "Xóa món ăn";
}

<div class="page-head">
    <div class="page-head__text">
        <h1>Xóa món ăn</h1>
        <p class="page-head__lede">Bạn sắp xóa món <strong>@Model.Name</strong> thuộc danh mục <strong>@Model.CategoryName</strong>.</p>
    </div>
</div>

<div class="surface stack">
    <div class="spec-grid">
        <div class="spec">
            <span class="spec__label">Vùng miền</span>
            <span class="spec__value">@Model.Region.ToDisplayName()</span>
        </div>
        <div class="spec">
            <span class="spec__label">Độ khó</span>
            <span class="spec__value">@Model.Difficulty.ToDisplayName()</span>
        </div>
        <div class="spec">
            <span class="spec__label">Nguyên liệu</span>
            <span class="spec__value tnum">@Model.IngredientCount</span>
        </div>
    </div>

    @if (Model.MenuPlanUsageCount > 0)
    {
        <div class="notice">
            Món đang được dùng trong <strong>@Model.MenuPlanUsageCount</strong> thực đơn nên chưa thể xóa. Hãy gỡ khỏi thực đơn trước.
        </div>
    }
    else
    {
        <div class="notice">
            Món sẽ bị xóa cùng @Model.IngredientCount dòng nguyên liệu của nó. Không thể hoàn tác.
        </div>
    }

    <form asp-action="Delete" method="post" class="row-inline">
        <input type="hidden" name="id" value="@Model.Id"/>
        <button type="submit" class="btn btn--solid-danger" disabled="@(Model.MenuPlanUsageCount > 0)">Xóa</button>
        <a class="btn btn--quiet" asp-action="Index">Hủy</a>
    </form>
</div>
