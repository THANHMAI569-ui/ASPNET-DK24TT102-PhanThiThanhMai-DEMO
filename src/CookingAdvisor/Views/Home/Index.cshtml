@model HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
    ViewData["FullBleed"] = true;

    var placeholder = Url.Content("~/images/recipe-placeholder.svg");
    string Photo(int index) =>
        index < Model.HeroImageUrls.Count ? Model.HeroImageUrls[index] : placeholder;

    // The planner preview below is built from real seeded dishes, not mock text.
    var previewDishes = Model.FeaturedRecipes.Take(3).ToList();
    string[] previewMeals = ["Sáng", "Trưa", "Tối"];
}

<div class="wrap">
    <partial name="_FlashMessages"/>
</div>

<section class="hero">
    <div class="hero__inner">
        <div class="hero__copy">
            <span class="eyebrow">Gợi ý nấu ăn cho gia đình</span>
            <h1 class="hero__title">Có sẵn nguyên liệu gì,<br/>nấu được <em>món gì</em></h1>
            <p class="hero__lede">
                Chọn từ @Model.IngredientCount nguyên liệu đang có, hệ thống xếp hạng món
                nấu được ngay và món còn thiếu gì.
            </p>
            <div class="hero__actions">
                <a class="btn btn--accent btn--lg" asp-controller="Suggestion" asp-action="Index">
                    <icon name="bulb"/> Gợi ý món ăn
                </a>
                <a class="btn btn--outline btn--lg" asp-controller="Recipe" asp-action="Index">
                    Duyệt món ăn
                </a>
            </div>
        </div>

        <div class="hero__media">
            <div class="hero__photo">
                <img src="@Photo(0)" alt="Món ăn Việt trong thư viện của CookingAdvisor"
                     data-fallback="@placeholder" width="900" height="1200" fetchpriority="high"/>
            </div>
            <div class="hero__photo hero__photo--short">
                <img src="@Photo(1)" alt="Một món ăn khác trong thư viện"
                     data-fallback="@placeholder" width="900" height="900" loading="lazy"/>
            </div>
        </div>
    </div>
</section>

<div class="wrap stack">
    <div class="section-head">
        <h2>Tìm theo loại món</h2>
    </div>
    @if (Model.Categories.Count == 0)
    {
        <div class="empty">
            <span class="empty__icon"><icon name="category" class="ico--lg"/></span>
            <p class="empty__title">Chưa có loại món nào</p>
            <p class="empty__text">Quản trị viên chưa thêm danh mục món ăn.</p>
        </div>
    }
    else
    {
        <div class="cat-rail">
            @foreach (var category in Model.Categories)
            {
                <a class="cat-tile" asp-controller="Recipe" asp-action="Index" asp-route-CategoryId="@category.Id">
                    @* A monogram, not an icon: the sprite has no glyph that honestly
                       stands for "Do uong" or "Trang mieng", and repeating one generic
                       icon nine times reads as filler. *@
                    <span class="cat-tile__icon" aria-hidden="true">@(category.Name.Length > 0 ? category.Name[..1] : "?")</span>
                    <span class="cat-tile__name">@category.Name</span>
                    <span class="cat-tile__count">@category.RecipeCount món</span>
                </a>
            }
        </div>
    }
</div>

<div class="wrap">
    <div class="flash-strip">
        <div class="flash-strip__head">
            <h2 class="flash-strip__title">Món nổi bật</h2>
            <span class="text-xs text-muted-3">@Model.RecipeCount món trong thư viện</span>
        </div>
        <div class="flash-strip__body">
            @if (Model.FeaturedRecipes.Count == 0)
            {
                <div class="empty">
                    <span class="empty__icon"><icon name="soup" class="ico--lg"/></span>
                    <p class="empty__title">Thư viện chưa có món nào</p>
                    <p class="empty__text">
                        Đăng nhập bằng tài khoản quản trị và thêm món đầu tiên để bắt đầu.
                    </p>
                </div>
            }
            else
            {
                <div class="product-grid">
                    @foreach (var recipe in Model.FeaturedRecipes)
                    {
                        <article class="product-card">
                            <div class="product-card__media">
                                <img class="product-card__img"
                                     src="@(string.IsNullOrEmpty(recipe.ImageUrl) ? placeholder : recipe.ImageUrl)"
                                     alt="@recipe.Name" data-fallback="@placeholder"
                                     width="400" height="400" loading="lazy"/>
                            </div>
                            <div class="product-card__body">
                                <h3 class="product-card__title">
                                    <a asp-controller="Recipe" asp-action="Details" asp-route-id="@recipe.Id">@recipe.Name</a>
                                </h3>
                                <div class="product-card__meta">
                                    <span class="tag">@recipe.CategoryName</span>
                                    <span class="tag">@recipe.Region.ToDisplayName()</span>
                                </div>
                                <div class="product-card__foot">
                                    <span class="price">@recipe.CaloriesPerServing<span class="price__unit">kcal</span></span>
                                    <span class="sold">@recipe.TotalMinutes phút</span>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div class="wrap">
    <div class="split">
        <div class="split__copy">
            <h2>Cả tuần ăn gì, quyết một lần</h2>
            <p>
                Thực đơn sinh tự động rồi bạn sửa tay từng bữa. Mỗi ngày có tổng calo
                để cân đối, và tạo được danh sách đi chợ ngay từ thực đơn đó.
            </p>
            <a class="btn btn--outline" asp-controller="Menu" asp-action="Index">
                <icon name="calendar-month"/> Tạo thực đơn
            </a>
        </div>

        @if (previewDishes.Count == 3)
        {
            <div class="surface surface--flush">
                <table class="data-table">
                    <caption class="visually-hidden-focusable">Ví dụ một ngày trong thực đơn tuần</caption>
                    <thead>
                        <tr>
                            <th scope="col">Bữa</th>
                            <th scope="col">Món</th>
                            <th scope="col" class="data-table__num">Calo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < previewDishes.Count; i++)
                        {
                            <tr>
                                <th scope="row" class="text-muted-3">@previewMeals[i]</th>
                                <td class="fw-600">@previewDishes[i].Name</td>
                                <td class="data-table__num">@previewDishes[i].CaloriesPerServing</td>
                            </tr>
                        }
                        <tr>
                            <th scope="row">Tổng</th>
                            <td class="text-muted-3 text-xs">một ngày</td>
                            <td class="data-table__num fw-600">
                                @previewDishes.Sum(d => d.CaloriesPerServing)
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="wrap">
    <div class="cta-band">
        <div class="stack-sm">
            <h2>Lưu thực đơn và món yêu thích</h2>
            <p>Tạo tài khoản để giữ lại thực đơn tuần, món yêu thích và danh sách đi chợ.</p>
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn btn--outline btn--lg" asp-controller="Menu" asp-action="Index">
                Vào thực đơn
            </a>
        }
        else
        {
            <a class="btn btn--outline btn--lg" asp-controller="Account" asp-action="Register">
                Tạo tài khoản
            </a>
        }
    </div>
</div>
