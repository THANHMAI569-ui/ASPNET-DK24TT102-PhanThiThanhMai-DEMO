@{
    ViewData["Title"] = "Tổng quan";
}

<div class="page-head">
    <div class="page-head__text">
        <h1>Tổng quan</h1>
        <p class="page-head__lede">Số liệu nhanh và lối tắt tới các mục quản trị.</p>
    </div>
</div>

<div class="stack-lg">
    <div class="stat-row">
        <div class="stat">
            <span class="stat__label"><icon name="tools-kitchen-2"/> Món ăn</span>
            <span class="stat__value tnum">@ViewBag.RecipeCount</span>
        </div>
        <div class="stat">
            <span class="stat__label"><icon name="carrot"/> Nguyên liệu</span>
            <span class="stat__value tnum">@ViewBag.IngredientCount</span>
        </div>
        <div class="stat">
            <span class="stat__label"><icon name="category"/> Danh mục</span>
            <span class="stat__value tnum">@ViewBag.CategoryCount</span>
        </div>
    </div>

    <div class="stack">
        <a class="btn btn--accent" asp-controller="Recipes" asp-action="Create">
            <icon name="plus"/> Thêm món ăn
        </a>
        <a class="btn btn--outline" asp-controller="Ingredients" asp-action="Create">
            <icon name="carrot"/> Thêm nguyên liệu
        </a>
        <a class="btn btn--outline" asp-controller="Categories" asp-action="Create">
            <icon name="category"/> Thêm danh mục
        </a>
    </div>
</div>
