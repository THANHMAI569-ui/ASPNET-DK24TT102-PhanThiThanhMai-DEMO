@model IReadOnlyList<FavoriteItemViewModel>
@{
    ViewData["Title"] = "Món yêu thích";

    var placeholder = Url.Content("~/images/recipe-placeholder.svg");
}

<div class="page-head">
    <div class="page-head__text">
        <h1>Món yêu thích</h1>
        <p class="page-head__lede">Danh sách món bạn đã lưu để nấu lại bất cứ lúc nào.</p>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="empty">
        <span class="empty__icon"><icon name="heart" class="ico--lg"/></span>
        <p class="empty__title">Chưa có món yêu thích nào</p>
        <p class="empty__text">Vào trang chi tiết món ăn và bấm nút yêu thích để lưu lại.</p>
        <a class="btn btn--outline" asp-controller="Recipe" asp-action="Index">Xem món ăn</a>
    </div>
}
else
{
    <div class="grid-cards">
        @foreach (var recipe in Model)
        {
            <article class="dish-card">
                <div class="dish-card__media">
                    <img class="dish-card__img"
                         src="@(string.IsNullOrEmpty(recipe.ImageUrl) ? placeholder : recipe.ImageUrl)"
                         alt="@recipe.Name" data-fallback="@placeholder"
                         width="900" height="675" loading="lazy"/>
                    <span class="pill pill--accent media-tag">@recipe.CategoryName</span>
                </div>
                <div class="dish-card__body">
                    <h3 class="dish-card__title">
                        <a asp-controller="Recipe" asp-action="Details" asp-route-id="@recipe.Id">@recipe.Name</a>
                    </h3>
                    <ul class="meta-list meta-list--tight">
                        <li><icon name="map-pin"/> @recipe.Region.ToDisplayName()</li>
                        <li><icon name="chart-bar"/> @recipe.Difficulty.ToDisplayName()</li>
                    </ul>
                    <div class="dish-card__foot">
                        <div class="dish-card__aside">
                            <form asp-controller="Favorite" asp-action="Toggle" method="post">
                                <input type="hidden" name="recipeId" value="@recipe.Id"/>
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path"/>
                                <button type="submit" class="icon-btn" aria-label="Bỏ yêu thích @recipe.Name">
                                    <icon name="heart"/>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </article>
        }
    </div>
}
