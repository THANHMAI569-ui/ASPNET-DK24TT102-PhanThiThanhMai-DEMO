@model RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="auth__card">
    <div class="stack-sm">
        <h1>Đăng ký tài khoản</h1>
        <p class="text-xs text-muted-3">Tạo tài khoản để lưu thực đơn tuần và món yêu thích.</p>
    </div>

    <form asp-action="Register" asp-route-returnUrl="@returnUrl" method="post" class="stack-sm">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="field">
            <label class="field__label" asp-for="FullName"></label>
            <input class="input" asp-for="FullName" autocomplete="name"/>
            <span class="field__error" asp-validation-for="FullName"></span>
        </div>

        <div class="field">
            <label class="field__label" asp-for="Email"></label>
            <input class="input" asp-for="Email" autocomplete="username"/>
            <span class="field__error" asp-validation-for="Email"></span>
        </div>

        <div class="field">
            <label class="field__label" asp-for="Password"></label>
            <p class="field__hint">Ít nhất 8 ký tự.</p>
            <input class="input" asp-for="Password" autocomplete="new-password"/>
            <span class="field__error" asp-validation-for="Password"></span>
        </div>

        <div class="field">
            <label class="field__label" asp-for="ConfirmPassword"></label>
            <input class="input" asp-for="ConfirmPassword" autocomplete="new-password"/>
            <span class="field__error" asp-validation-for="ConfirmPassword"></span>
        </div>

        <button type="submit" class="btn btn--accent btn--block">
            <icon name="user-circle"/> Đăng ký
        </button>
    </form>
</div>

<p class="auth__foot">
    Đã có tài khoản? <a asp-action="Login" asp-route-returnUrl="@returnUrl">Đăng nhập</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
