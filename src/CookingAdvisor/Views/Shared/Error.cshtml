@model ErrorViewModel
@{
    ViewData["Title"] = "Đã có lỗi xảy ra";
}

<div class="empty">
    <span class="empty__icon"><icon name="alert-triangle" class="ico--lg"/></span>
    <p class="empty__title">Đã có lỗi xảy ra</p>
    <p class="empty__text">
        Rất tiếc, có lỗi khi xử lý yêu cầu của bạn. Vui lòng thử lại hoặc quay về trang chủ.
    </p>
    @if (Model.ShowRequestId)
    {
        <p class="text-xs text-muted-3">Mã yêu cầu: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn--outline" asp-controller="Home" asp-action="Index">Về trang chủ</a>
</div>

<div class="notice">
    Chế độ Development sẽ hiển thị thông tin lỗi chi tiết hơn cho người phát triển. Không nên bật môi trường
    Development cho ứng dụng đã triển khai, vì có thể lộ thông tin nhạy cảm từ lỗi hệ thống cho người dùng.
    Để gỡ lỗi cục bộ, đặt biến môi trường ASPNETCORE_ENVIRONMENT thành Development rồi khởi động lại ứng dụng.
</div>
