@model SuggestionViewModel
@{
    ViewData["Title"] = "Gợi ý theo nguyên liệu";

    var placeholder = Url.Content("~/images/recipe-placeholder.svg");
}

<div class="page-head">
    <div class="page-head__text">
        <h1>Gợi ý theo nguyên liệu</h1>
        <p class="page-head__lede">
            Chọn nguyên liệu đang có, hệ thống xếp hạng món nấu được ngay và món còn thiếu gì.
        </p>
    </div>
</div>

<div class="filter-backdrop" data-filter-backdrop></div>

<div class="shell">
    <aside class="filter-side" id="filter-panel">
        <div class="filter-side__head">
            <span>Nguyên liệu</span>
            <button class="icon-btn" type="button" data-filter-close aria-label="Đóng danh sách nguyên liệu">
                <icon name="x"/>
            </button>
        </div>
        <form asp-action="Index" method="get" class="stack">
            <div class="filter-group">
                <p class="filter-group__title">Nguyên liệu đang có</p>
                @foreach (var ingredient in Model.Ingredients)
                {
                    <label class="checkline">
                        <input type="checkbox" name="ingredientIds" value="@ingredient.Id"
                               checked="@Model.SelectedIngredientIds.Contains(ingredient.Id)"/>
                        @ingredient.Name
                    </label>
                }
            </div>
            <button type="submit" class="btn btn--accent">
                <icon name="sparkles"/> Gợi ý món
            </button>
        </form>
        <a asp-action="Index" class="btn btn--outline btn--block">Xoá tất cả</a>
    </aside>

    <div class="stack">
        <button class="btn btn--outline filter-toggle self-start" type="button"
                data-filter-toggle aria-expanded="false" aria-controls="filter-panel">
            <icon name="adjustments-horizontal"/> Chọn nguyên liệu
        </button>

        @if (!Model.HasSearched)
        {
            <div class="empty">
                <span class="empty__icon"><icon name="bulb" class="ico--lg"/></span>
                <p class="empty__title">Chưa chọn nguyên liệu nào</p>
                <p class="empty__text">Tick vào nguyên liệu bạn đang có ở bên trái rồi bấm Gợi ý món.</p>
            </div>
        }
        else
        {
            <div class="row-inline">
                @foreach (var id in Model.SelectedIngredientIds)
                {
                    var name = Model.Ingredients.FirstOrDefault(i => i.Id == id)?.Name ?? $"#{id}";
                    <span class="chip">@name</span>
                }
            </div>

            @if (Model.Results.Count == 0)
            {
                <div class="empty">
                    <span class="empty__icon"><icon name="soup" class="ico--lg"/></span>
                    <p class="empty__title">Không có món nào khớp</p>
                    <p class="empty__text">Thử chọn thêm nguyên liệu khác hoặc bớt nguyên liệu ít phổ biến.</p>
                </div>
            }
            else
            {
                <div class="sortbar">
                    <span class="sortbar__label">Xếp hạng theo độ phù hợp</span>
                    <span class="sortbar__count"><span class="tnum">@Model.Results.Count</span> món phù hợp</span>
                </div>

                <div class="product-grid">
                    @foreach (var recipe in Model.Results)
                    {
                        <article class="product-card">
                            <div class="product-card__media">
                                <img class="product-card__img"
                                     src="@(string.IsNullOrEmpty(recipe.ImageUrl) ? placeholder : recipe.ImageUrl)"
                                     alt="@recipe.Name" data-fallback="@placeholder"
                                     width="400" height="400" loading="lazy"/>
                                @if (recipe.CanCookNow)
                                {
                                    <span class="ribbon ribbon--ok">Đủ nguyên liệu</span>
                                }
                                else
                                {
                                    <span class="ribbon ribbon--warn">Thiếu @recipe.MissingIngredients.Count nguyên liệu</span>
                                }
                            </div>
                            <div class="product-card__body">
                                <h3 class="product-card__title">
                                    <a asp-controller="Recipe" asp-action="Details" asp-route-id="@recipe.RecipeId">@recipe.Name</a>
                                </h3>
                                <div class="product-card__meta">
                                    <span class="tag">@recipe.CategoryName</span>
                                    <span class="tag"><span class="tnum">@recipe.MatchedCount</span>/<span class="tnum">@recipe.TotalIngredientCount</span> nguyên liệu</span>
                                </div>
                                @if (!recipe.CanCookNow)
                                {
                                    <div class="row-inline">
                                        @foreach (var missing in recipe.MissingIngredients)
                                        {
                                            <span class="pill pill--warn">@missing</span>
                                        }
                                    </div>
                                }
                                <div class="product-card__foot">
                                    <span class="price">@recipe.CaloriesPerServing<span class="price__unit">kcal</span></span>
                                    <span class="sold"><span class="tnum">@recipe.TotalMinutes</span> phút</span>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        }
    </div>
</div>
