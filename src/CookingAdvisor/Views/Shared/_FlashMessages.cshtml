@if (TempData["Success"] is string success)
{
    <div class="flash flash--ok" role="status">
        <icon name="circle-check"/>
        <span class="flash__body">@success</span>
        <button class="flash__close" type="button" data-flash-close aria-label="Đóng thông báo">
            <icon name="x"/>
        </button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="flash flash--error" role="alert">
        <icon name="alert-circle"/>
        <span class="flash__body">@error</span>
        <button class="flash__close" type="button" data-flash-close aria-label="Đóng thông báo">
            <icon name="x"/>
        </button>
    </div>
}
