@model IngredientFormViewModel
@{
    ViewData["Title"] = "Thêm nguyên liệu";
}

<div class="page-head">
    <div class="page-head__text">
        <h1>Thêm nguyên liệu</h1>
        <p class="page-head__lede">Thêm nguyên liệu mới vào danh sách dùng cho công thức.</p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn--quiet" asp-action="Index"><icon name="arrow-left"/> Quay lại</a>
    </div>
</div>

<div class="surface">
    <form asp-action="Create" method="post" class="stack">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="form-grid">
            <div class="field">
                <label class="field__label" asp-for="Name">Tên nguyên liệu</label>
                <input class="input" asp-for="Name"/>
                <span class="field__error" asp-validation-for="Name"></span>
            </div>
            <div class="field">
                <label class="field__label" asp-for="Unit">Đơn vị</label>
                <p class="field__hint">Ví dụ: kg, quả, bó.</p>
                <input class="input" asp-for="Unit" placeholder="kg, quả, bó..."/>
                <span class="field__error" asp-validation-for="Unit"></span>
            </div>
            <div class="field">
                <label class="field__label" asp-for="Group">Nhóm</label>
                <p class="field__hint">Ví dụ: Thịt, Rau củ, Gia vị.</p>
                <input class="input" asp-for="Group" placeholder="Thịt, Rau củ, Gia vị..."/>
                <span class="field__error" asp-validation-for="Group"></span>
            </div>
        </div>

        <div class="row-inline">
            <button type="submit" class="btn btn--accent">Lưu</button>
            <a class="btn btn--quiet" asp-action="Index">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
