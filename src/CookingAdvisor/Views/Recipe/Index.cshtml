@model RecipeListViewModel
@{
    ViewData["Title"] = "Danh sách món ăn";
    var f = Model.Filter;
    var placeholder = Url.Content("~/images/recipe-placeholder.svg");
}

<div class="page-head">
    <div class="page-head__text">
        <h1>Danh sách món ăn</h1>
        <p class="page-head__lede">Lọc theo tên, danh mục, vùng miền, độ khó hoặc thời gian nấu.</p>
    </div>
</div>

<form asp-action="Index" method="get" class="filter-bar">
    <div class="field filter-bar__search">
        <label class="field__label" for="Keyword">Tìm theo tên</label>
        <input type="search" id="Keyword" name="Keyword" value="@f.Keyword"
               class="input" placeholder="Ví dụ: phở, gà, canh chua"/>
    </div>
    <div class="field">
        <label class="field__label" for="CategoryId">Danh mục</label>
        <select id="CategoryId" name="CategoryId" class="select">
            <option value="">Tất cả</option>
            @foreach (var c in Model.Categories)
            {
                <option value="@c.Id" selected="@(f.CategoryId == c.Id)">@c.Name</option>
            }
        </select>
    </div>
    <div class="field">
        <label class="field__label" for="Region">Vùng miền</label>
        <select id="Region" name="Region" class="select">
            <option value="">Tất cả</option>
            @foreach (var region in Enum.GetValues<Region>())
            {
                <option value="@region" selected="@(f.Region == region)">@region.ToDisplayName()</option>
            }
        </select>
    </div>
    <div class="field">
        <label class="field__label" for="Difficulty">Độ khó</label>
        <select id="Difficulty" name="Difficulty" class="select">
            <option value="">Tất cả</option>
            @foreach (var difficulty in Enum.GetValues<Difficulty>())
            {
                <option value="@difficulty" selected="@(f.Difficulty == difficulty)">@difficulty.ToDisplayName()</option>
            }
        </select>
    </div>
    <div class="field">
        <label class="field__label" for="MaxCookMinutes">Thời gian nấu tối đa (phút)</label>
        <input type="number" id="MaxCookMinutes" name="MaxCookMinutes" value="@f.MaxCookMinutes"
               min="0" step="5" class="input" placeholder="Không giới hạn"/>
    </div>
    <div class="filter-bar__actions">
        <button type="submit" class="btn btn--accent">Lọc</button>
        <a asp-action="Index" class="btn btn--quiet">Xoá lọc</a>
    </div>
</form>

<p class="text-sm text-muted-3">Tìm thấy <span class="tnum">@Model.TotalCount</span> món.</p>

@if (Model.Recipes.Count == 0)
{
    <div class="empty">
        <span class="empty__icon"><icon name="soup" class="ico--lg"/></span>
        <p class="empty__title">Chưa có món nào khớp</p>
        <p class="empty__text">Thử bỏ một điều kiện lọc hoặc tăng thời gian nấu tối đa.</p>
        <a class="btn btn--outline" asp-action="Index">Xoá lọc</a>
    </div>
}
else
{
    <div class="grid-cards">
        @foreach (var recipe in Model.Recipes)
        {
            <article class="dish-card">
                <div class="dish-card__media">
                    <img class="dish-card__img"
                         src="@(string.IsNullOrEmpty(recipe.ImageUrl) ? placeholder : recipe.ImageUrl)"
                         alt="@recipe.Name" data-fallback="@placeholder"
                         width="900" height="675" loading="lazy"/>
                    <span class="pill pill--accent media-tag">@recipe.CategoryName</span>
                </div>
                <div class="dish-card__body">
                    <h3 class="dish-card__title">
                        <a asp-action="Details" asp-route-id="@recipe.Id">@recipe.Name</a>
                    </h3>
                    <ul class="meta-list meta-list--tight">
                        <li><icon name="clock"/> <span class="tnum">@recipe.TotalMinutes</span> phút</li>
                        <li><icon name="flame"/> <span class="tnum">@recipe.CaloriesPerServing</span> kcal</li>
                        <li><icon name="chart-bar"/> @recipe.Difficulty.ToDisplayName()</li>
                    </ul>
                </div>
            </article>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="pager" aria-label="Phân trang">
            <a class="pager__link @(Model.HasPrevious ? "" : "is-disabled")"
               asp-action="Index"
               asp-route-Keyword="@f.Keyword"
               asp-route-CategoryId="@f.CategoryId"
               asp-route-Region="@f.Region"
               asp-route-Difficulty="@f.Difficulty"
               asp-route-MaxCookMinutes="@f.MaxCookMinutes"
               asp-route-Page="@(Model.Page - 1)" aria-label="Trang trước">
                <icon name="chevron-left"/>
            </a>
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <a class="pager__link @(p == Model.Page ? "is-active" : "")"
                   asp-action="Index"
                   asp-route-Keyword="@f.Keyword"
                   asp-route-CategoryId="@f.CategoryId"
                   asp-route-Region="@f.Region"
                   asp-route-Difficulty="@f.Difficulty"
                   asp-route-MaxCookMinutes="@f.MaxCookMinutes"
                   asp-route-Page="@p">@p</a>
            }
            <a class="pager__link @(Model.HasNext ? "" : "is-disabled")"
               asp-action="Index"
               asp-route-Keyword="@f.Keyword"
               asp-route-CategoryId="@f.CategoryId"
               asp-route-Region="@f.Region"
               asp-route-Difficulty="@f.Difficulty"
               asp-route-MaxCookMinutes="@f.MaxCookMinutes"
               asp-route-Page="@(Model.Page + 1)" aria-label="Trang sau">
                <icon name="chevron-right"/>
            </a>
        </nav>
    }
}
