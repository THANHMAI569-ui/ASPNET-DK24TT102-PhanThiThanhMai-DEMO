@model RecipeFormViewModel

<div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

<div class="form-grid">
    <div class="field form-grid__full">
        <label class="field__label" asp-for="Name">Tên món</label>
        <input class="input" asp-for="Name"/>
        <span class="field__error" asp-validation-for="Name"></span>
    </div>

    <div class="field">
        <label class="field__label" asp-for="CategoryId">Danh mục</label>
        <select class="select" asp-for="CategoryId">
            <option value="0">Chọn danh mục</option>
            @foreach (var c in Model.CategoryOptions)
            {
                <option value="@c.Id">@c.Name</option>
            }
        </select>
        <span class="field__error" asp-validation-for="CategoryId"></span>
    </div>

    <div class="field">
        <label class="field__label" asp-for="Region">Vùng miền</label>
        <select class="select" asp-for="Region">
            @foreach (var region in Enum.GetValues<Region>())
            {
                <option value="@region" selected="@(Model.Region == region)">@region.ToDisplayName()</option>
            }
        </select>
        <span class="field__error" asp-validation-for="Region"></span>
    </div>

    <div class="field">
        <label class="field__label" asp-for="Difficulty">Độ khó</label>
        <select class="select" asp-for="Difficulty">
            @foreach (var difficulty in Enum.GetValues<Difficulty>())
            {
                <option value="@difficulty" selected="@(Model.Difficulty == difficulty)">@difficulty.ToDisplayName()</option>
            }
        </select>
        <span class="field__error" asp-validation-for="Difficulty"></span>
    </div>

    <div class="field">
        <label class="field__label" asp-for="Servings">Khẩu phần</label>
        <input class="input" asp-for="Servings" type="number" min="1"/>
        <span class="field__error" asp-validation-for="Servings"></span>
    </div>

    <div class="field">
        <label class="field__label" asp-for="PrepMinutes">Thời gian sơ chế (phút)</label>
        <input class="input" asp-for="PrepMinutes" type="number" min="0"/>
        <span class="field__error" asp-validation-for="PrepMinutes"></span>
    </div>

    <div class="field">
        <label class="field__label" asp-for="CookMinutes">Thời gian nấu (phút)</label>
        <input class="input" asp-for="CookMinutes" type="number" min="0"/>
        <span class="field__error" asp-validation-for="CookMinutes"></span>
    </div>

    <div class="field">
        <label class="field__label" asp-for="CaloriesPerServing">Calo / khẩu phần</label>
        <input class="input" asp-for="CaloriesPerServing" type="number" min="0"/>
        <span class="field__error" asp-validation-for="CaloriesPerServing"></span>
    </div>

    <div class="field">
        <label class="field__label" asp-for="ImageUrl">Ảnh</label>
        <p class="field__hint">
            Đường dẫn ảnh trong wwwroot, ví dụ /images/recipes/pho-bo.jpg. Để trống thì dùng ảnh mặc định.
        </p>
        <input class="input" asp-for="ImageUrl" placeholder="/images/recipes/ten-mon.jpg"/>
        <span class="field__error" asp-validation-for="ImageUrl"></span>
    </div>

    <div class="field form-grid__full">
        <label class="field__label" asp-for="Description">Mô tả</label>
        <textarea class="textarea" asp-for="Description" rows="2"></textarea>
        <span class="field__error" asp-validation-for="Description"></span>
    </div>

    <div class="field form-grid__full">
        <label class="field__label" asp-for="Instructions">Cách làm</label>
        <textarea class="textarea" asp-for="Instructions" rows="6"></textarea>
        <span class="field__error" asp-validation-for="Instructions"></span>
    </div>

    <div class="field form-grid__full">
        <label class="field__label">Nguyên liệu</label>
        <p class="field__hint">Chọn nguyên liệu, nhập số lượng và đơn vị cho từng dòng.</p>

        <div id="ingredients-body" class="stack-sm">
            @for (var i = 0; i < Model.Ingredients.Count; i++)
            {
                var item = Model.Ingredients[i];
                <div class="repeater__row ingredient-row">
                    <input type="hidden" name="Ingredients.Index" value="@i"/>
                    <select name="Ingredients[@i].IngredientId" class="select">
                        <option value="0">Chọn nguyên liệu</option>
                        @foreach (var opt in Model.IngredientOptions)
                        {
                            <option value="@opt.Id" data-unit="@opt.Unit" selected="@(opt.Id == item.IngredientId)">@opt.Name</option>
                        }
                    </select>
                    @* Invariant formatting on purpose: on a vi-VN Windows machine the
                       default culture renders 0.3 as "0,3", which input[type=number]
                       rejects, so the quantity field would open blank. *@
                    <input name="Ingredients[@i].Quantity"
                           value="@item.Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                           type="number" step="0.01" min="0" class="input"/>
                    <input name="Ingredients[@i].Unit" value="@item.Unit" class="input"/>
                    <button type="button" class="icon-btn remove-ingredient" aria-label="Xóa dòng nguyên liệu">
                        <icon name="trash"/>
                    </button>
                </div>
            }
        </div>

        <button type="button" id="add-ingredient" class="btn btn--outline btn--sm">
            <icon name="plus"/> Thêm dòng
        </button>
    </div>
</div>

<template id="ingredient-row-template">
    <div class="repeater__row ingredient-row">
        <input type="hidden" name="Ingredients.Index" value="__i__"/>
        <select name="Ingredients[__i__].IngredientId" class="select">
            <option value="0">Chọn nguyên liệu</option>
            @foreach (var opt in Model.IngredientOptions)
            {
                <option value="@opt.Id" data-unit="@opt.Unit">@opt.Name</option>
            }
        </select>
        <input name="Ingredients[__i__].Quantity" type="number" step="0.01" min="0" class="input"/>
        <input name="Ingredients[__i__].Unit" class="input"/>
        <button type="button" class="icon-btn remove-ingredient" aria-label="Xóa dòng nguyên liệu">
            <icon name="trash"/>
        </button>
    </div>
</template>

<script>
    (function () {
        var body = document.getElementById('ingredients-body');
        var template = document.getElementById('ingredient-row-template').innerHTML;
        var counter = @Model.Ingredients.Count;

        document.getElementById('add-ingredient').addEventListener('click', function () {
            var html = template.replace(/__i__/g, counter++);
            var holder = document.createElement('div');
            holder.innerHTML = html.trim();
            body.appendChild(holder.firstElementChild);
        });

        body.addEventListener('click', function (e) {
            var button = e.target.closest('.remove-ingredient');
            if (button) {
                var row = button.closest('.ingredient-row');
                row.parentNode.removeChild(row);
            }
        });

        body.addEventListener('change', function (e) {
            if (e.target.tagName === 'SELECT') {
                var option = e.target.options[e.target.selectedIndex];
                var unit = option.getAttribute('data-unit');
                var unitInput = e.target.closest('.ingredient-row').querySelector('input[name$=".Unit"]');
                if (unit && unitInput && !unitInput.value) {
                    unitInput.value = unit;
                }
            }
        });
    })();
</script>
